# Se debe crear un fichero .env y esta sería la plantilla

# Aplicación
APP_NAME=Cook-List

# Backend - Java + Spring Boot : 8080
SERVER_PORT=

# Base de datos - PostgreSQL
DB_HOST=
DB_PORT=
DB_NAME=
DB_USERNAME=
DB_PASSWORD=

# Cconfiguración JWT
JWT_SECRET=
JWT_EXPIRATION=

# Flyway: contraseñas de los usuarios iniciales (mínimo 8 caracteres)
ADMIN_PASSWORD=
USER_PASSWORD=